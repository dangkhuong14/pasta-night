# Copy to .env and fill in. The server reads the environment only; it never loads .env itself.
# Reference: docs/ARCHITECTURE.md §6.

# Required. TMDB API Read Access Token (TMDB account → Settings → API).
TMDB_READ_TOKEN=

# Admin endpoints (POST /api/v1/admin/refresh), sent as the X-Admin-Token header.
# Empty = admin endpoints disabled (404 NOT_FOUND). Use a long random value, e.g.: openssl rand -hex 32
ADMIN_TOKEN=

# Comma-separated frontend origins allowed by CORS. No "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional — defaults shown.
PORT=8080
TMDB_LANGUAGE=vi-VN
WATCH_REGION=VN
CACHE_DIR=./data/cache
LIST_TTL=168h
DETAIL_TTL=336h
REFRESH_CHECK_INTERVAL=1h
DISCOVER_PAGES=2
TMDB_CONCURRENCY=5
