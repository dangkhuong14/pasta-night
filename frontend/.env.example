# Copy to .env.local. NEXT_PUBLIC_* values are inlined at build time: change → rebuild.
# Reference: docs/ARCHITECTURE.md §7.

# Backend base URL including /api/v1, e.g. http://localhost:8080/api/v1.
# Empty = mock data from src/lib/mock-data.ts (no backend needed).
NEXT_PUBLIC_API_BASE_URL=

# "Mua ngay" shop link in the movie detail sheet. Empty = PromoCard hidden.
NEXT_PUBLIC_SHOP_URL=
